NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casax?schema=public
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_ACCESS_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=

EMAIL_PROVIDER=dev
EMAIL_FROM="CasaX <no-reply@casax.local>"
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
EMAIL_TOKEN_TTL_HOURS=72

GMAIL_USER=
GMAIL_APP_PASSWORD=
# Gmail SMTP notes:
# - Enable 2-Step Verification on the Gmail account.
# - Use a Gmail App Password, not the normal Gmail password.
# - Remove spaces from the App Password before saving it here.

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
CASAX_PLATFORM_FEE_PERCENT=5
SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_PAST_DUE_GRACE_DAYS=7
