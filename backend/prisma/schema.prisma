generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN     @map("admin")
  LANDLORD  @map("landlord")
  CARETAKER @map("caretaker")
  APPLICANT @map("applicant")
  TENANT    @map("tenant")
}

enum PropertyStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum PropertyVerificationStatus {
  PENDING  @map("pending")
  VERIFIED @map("verified")
  REJECTED @map("rejected")
}

enum PropertyListingStatus {
  DRAFT          @map("draft")
  PENDING_REVIEW @map("pending_review")
  APPROVED       @map("approved")
  REJECTED       @map("rejected")
  SUSPENDED      @map("suspended")
}

enum UnitStatus {
  VACANT           @map("vacant")
  OCCUPIED         @map("occupied")
  PENDING_APPROVAL @map("pending_approval")
  MAINTENANCE      @map("maintenance")
  INACTIVE         @map("inactive")
}

enum UnitReadinessStatus {
  INCOMPLETE @map("incomplete")
  READY      @map("ready")
}

enum VacancyStatus {
  PRIVATE     @map("private")
  PUBLISHED   @map("published")
  UNPUBLISHED @map("unpublished")
  FILLED      @map("filled")
}

enum ApplicationStatus {
  PENDING             @map("pending")
  INSPECTION_REQUIRED @map("inspection_required")
  INSPECTION_SCHEDULED @map("inspection_scheduled")
  INSPECTION_BOOKED   @map("inspection_booked")
  UNDER_REVIEW        @map("under_review")
  APPROVED            @map("approved")
  REJECTED            @map("rejected")
  CONVERTED_TO_TENANT @map("converted_to_tenant")
}

enum InspectionStatus {
  REQUESTED @map("requested")
  CONFIRMED @map("confirmed")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

enum TenancyStatus {
  PENDING    @map("pending")
  ACTIVE     @map("active")
  EXPIRED    @map("expired")
  TERMINATED @map("terminated")
}

enum PaymentFrequency {
  MONTHLY   @map("monthly")
  QUARTERLY @map("quarterly")
  BIANNUAL  @map("biannual")
  YEARLY    @map("yearly")
}

enum TenantOnboardingStatus {
  PENDING              @map("pending")
  APPROVED             @map("approved")
  REJECTED             @map("rejected")
  CONVERTED_TO_TENANCY @map("converted_to_tenancy")
}

enum AgreementStatus {
  DRAFT     @map("draft")
  GENERATED @map("generated")
  SENT      @map("sent")
  SIGNED    @map("signed")
  CANCELLED @map("cancelled")
}

enum TenantInvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  EXPIRED  @map("expired")
  REVOKED  @map("revoked")
}

enum AuthEmailTokenStatus {
  PENDING @map("pending")
  USED    @map("used")
  EXPIRED @map("expired")
  REVOKED @map("revoked")
}

enum EmailLogStatus {
  QUEUED @map("queued")
  SENT   @map("sent")
  FAILED @map("failed")
}

enum EmailType {
  EMAIL_VERIFICATION          @map("email_verification")
  PASSWORD_RESET              @map("password_reset")
  TENANT_INVITATION           @map("tenant_invitation")
  ACCOUNT_SETUP               @map("account_setup")
  TENANCY_AGREEMENT_GENERATED @map("tenancy_agreement_generated")
  PAYMENT_INVOICE             @map("payment_invoice")
  PAYMENT_RECEIPT             @map("payment_receipt")
}

enum PaymentStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  PAID       @map("paid")
  OVERDUE    @map("overdue")
  FAILED     @map("failed")
  CANCELLED  @map("cancelled")
}

enum PaymentMethod {
  BANK_TRANSFER  @map("bank_transfer")
  CASH           @map("cash")
  POS            @map("pos")
  CARD           @map("card")
  ONLINE_GATEWAY @map("online_gateway")
}

enum PaymentProvider {
  PAYSTACK    @map("paystack")
  FLUTTERWAVE @map("flutterwave")
}

enum PaymentPurpose {
  RENT    @map("rent")
  RENEWAL @map("renewal")
}

enum LandlordRemittanceStatus {
  PENDING    @map("pending")
  APPROVED   @map("approved")
  PROCESSING @map("processing")
  PAID       @map("paid")
  FAILED     @map("failed")
  REJECTED   @map("rejected")
}

enum RemittanceStatus {
  PENDING            @map("pending")
  PARTIALLY_REMITTED @map("partially_remitted")
  REMITTED           @map("remitted")
  DISPUTED           @map("disputed")
  CANCELLED          @map("cancelled")
}

enum MaintenanceStatus {
  PENDING     @map("pending")
  IN_PROGRESS @map("in_progress")
  RESOLVED    @map("resolved")
  CANCELLED   @map("cancelled")
}

enum LegacySubscriptionPlan {
  STARTER  @map("starter")
  GROWTH   @map("growth")
  BUSINESS @map("business")

  @@map("SubscriptionPlan")
}

enum SubscriptionPlanType {
  STARTER    @map("starter")
  GROWTH     @map("growth")
  ENTERPRISE @map("enterprise")
}

enum BillingCycle {
  MONTHLY  @map("monthly")
  ANNUALLY @map("annually")
  CUSTOM   @map("custom")
}

enum SubscriptionStatus {
  TRIALING  @map("trialing")
  ACTIVE    @map("active")
  PAST_DUE  @map("past_due")
  CANCELLED @map("cancelled")
  EXPIRED   @map("expired")
}

enum SubscriptionPaymentStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  PAID       @map("paid")
  FAILED     @map("failed")
  CANCELLED  @map("cancelled")
}

model User {
  id                      String                       @id @default(uuid()) @db.Uuid
  email                   String                       @unique
  passwordHash            String                       @map("password_hash")
  refreshTokenHash        String?                      @map("refresh_token_hash")
  role                    UserRole
  isActive                Boolean                      @default(true) @map("is_active")
  emailVerifiedAt         DateTime?                    @map("email_verified_at")
  profile                 Profile?
  landlord                Landlord?
  caretaker               Caretaker?
  applicant               Applicant?
  tenancies               Tenancy[]                    @relation("TenantUser")
  occupancyRecords        OccupancyRecord[]
  occupancyAssignments    OccupancyAssignment[]        @relation("AssignedOccupant")
  maintenanceRequests     MaintenanceRequest[]         @relation("MaintenanceRequester")
  maintenanceUpdates      MaintenanceUpdate[]          @relation("MaintenanceUpdater")
  notifications           Notification[]
  activityLogs            ActivityLog[]                @relation("ActivityActor")
  createdApplications     VacancyApplication[]         @relation("ApplicationCreator")
  applicationReviews      ApplicationApprovalHistory[] @relation("ApplicationReviewer")
  rentPaymentsMade        RentPayment[]                @relation("RentPayer")
  rentPaymentsAsTenant    RentPayment[]                @relation("RentPaymentTenant")
  renewalPayments         LeaseRenewalPayment[]        @relation("RenewalPaymentTenant")
  paymentTransactions     PaymentTransaction[]         @relation("PaymentTransactionTenant")
  receipts                Receipt[]                    @relation("ReceiptTenant")
  approvedRemittances     LandlordRemittance[]         @relation("RemittanceApprover")
  submittedOnboarding     TenantOnboardingRequest[]    @relation("OnboardingSubmitter")
  reviewedOnboarding      TenantOnboardingRequest[]    @relation("OnboardingReviewer")
  createdAgreements       TenancyAgreement[]           @relation("AgreementCreator")
  agreementsAsTenant      TenancyAgreement[]           @relation("AgreementTenant")
  tenantInvitations       TenantInvitation[]           @relation("InvitationTenant")
  sentInvitations         TenantInvitation[]           @relation("InvitationSender")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  deletedAt               DateTime?                    @map("deleted_at")

  @@index([role, isActive])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  phone     String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model Landlord {
  id                    String                    @id @default(uuid()) @db.Uuid
  userId                String                    @unique @map("user_id") @db.Uuid
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessName          String?                   @map("business_name")
  properties            Property[]
  caretakerAssignments  CaretakerAssignment[]
  tenancies             Tenancy[]
  rentPayments          RentPayment[]
  remittances           RemittanceRecord[]
  landlordRemittances   LandlordRemittance[]
  subscriptions         Subscription[]
  landlordSubscriptions LandlordSubscription[]
  subscriptionPayments  SubscriptionPayment[]
  vacancyListings       VacancyListing[]
  applications          VacancyApplication[]
  onboardingRequests    TenantOnboardingRequest[]
  agreements            TenancyAgreement[]
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  deletedAt             DateTime?                 @map("deleted_at")

  @@index([deletedAt])
  @@map("landlords")
}

model Caretaker {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @unique @map("user_id") @db.Uuid
  user               User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments        CaretakerAssignment[]
  payments           RentPayment[]             @relation("CollectedByCaretaker")
  remittances        RemittanceRecord[]
  maintenance        MaintenanceRequest[]      @relation("AssignedCaretaker")
  applications       VacancyApplication[]      @relation("ApplicationCaretaker")
  onboardingRequests TenantOnboardingRequest[]
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  deletedAt          DateTime?                 @map("deleted_at")

  @@index([deletedAt])
  @@map("caretakers")
}

model Applicant {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @unique @map("user_id") @db.Uuid
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  applications       VacancyApplication[]
  inspectionBookings InspectionBooking[]
  savedRentals       SavedRental[]
  tenancies          Tenancy[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  deletedAt          DateTime?            @map("deleted_at")

  @@index([deletedAt])
  @@map("applicants")
}

model SavedRental {
  id               String         @id @default(uuid()) @db.Uuid
  applicantId      String         @map("applicant_id") @db.Uuid
  applicant        Applicant      @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  vacancyListingId String         @map("vacancy_listing_id") @db.Uuid
  vacancyListing   VacancyListing @relation(fields: [vacancyListingId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now()) @map("created_at")
  deletedAt        DateTime?      @map("deleted_at")

  @@unique([applicantId, vacancyListingId])
  @@index([applicantId, createdAt])
  @@index([vacancyListingId])
  @@index([deletedAt])
  @@map("saved_rentals")
}

model Property {
  id                   String                     @id @default(uuid()) @db.Uuid
  landlordId           String                     @map("landlord_id") @db.Uuid
  landlord             Landlord                   @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  name                 String
  address              String
  city                 String
  state                String
  type                 String
  status               PropertyStatus             @default(ACTIVE)
  verificationStatus   PropertyVerificationStatus @default(PENDING) @map("verification_status")
  listingStatus        PropertyListingStatus      @default(PENDING_REVIEW) @map("listing_status")
  units                Unit[]
  caretakerAssignments CaretakerAssignment[]
  tenancies            Tenancy[]
  occupancyRecords     OccupancyRecord[]
  maintenanceRequests  MaintenanceRequest[]
  applications         VacancyApplication[]
  rentPayments         RentPayment[]
  remittances          RemittanceRecord[]
  renewalPayments      LeaseRenewalPayment[]
  paymentTransactions  PaymentTransaction[]
  receipts             Receipt[]
  landlordRemittances  LandlordRemittance[]
  onboardingRequests   TenantOnboardingRequest[]
  agreements           TenancyAgreement[]
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  deletedAt            DateTime?                  @map("deleted_at")

  @@index([landlordId, status])
  @@index([city, state])
  @@index([deletedAt])
  @@map("properties")
}

model Unit {
  id                   String                    @id @default(uuid()) @db.Uuid
  propertyId           String                    @map("property_id") @db.Uuid
  property             Property                  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  name                 String
  rentAmount           Decimal                   @map("rent_amount") @db.Decimal(14, 2)
  bedroomCount         Int                       @map("bedroom_count")
  bathroomCount        Int                       @default(0) @map("bathroom_count")
  unitType             String                    @map("unit_type")
  listingTitle         String?                   @map("listing_title")
  publicDescription    String?                   @map("public_description")
  photos               Json?                     @map("photos")
  amenities            String[]                  @default([])
  serviceCharge        Decimal?                  @map("service_charge") @db.Decimal(14, 2)
  depositAmount        Decimal?                  @map("deposit_amount") @db.Decimal(14, 2)
  availabilityDate     DateTime?                 @map("availability_date")
  inspectionNotes      String?                   @map("inspection_notes")
  readinessStatus      UnitReadinessStatus       @default(INCOMPLETE) @map("readiness_status")
  status               UnitStatus                @default(VACANT)
  isPubliclyVisible    Boolean                   @default(false) @map("is_publicly_visible")
  images               UnitImage[]
  vacancyListings      VacancyListing[]
  applications         VacancyApplication[]
  inspectionBookings   InspectionBooking[]
  tenancies            Tenancy[]
  occupancyRecords     OccupancyRecord[]
  occupancyAssignments OccupancyAssignment[]
  rentPayments         RentPayment[]
  maintenanceRequests  MaintenanceRequest[]
  onboardingRequests   TenantOnboardingRequest[]
  agreements           TenancyAgreement[]
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  deletedAt            DateTime?                 @map("deleted_at")

  @@unique([propertyId, name])
  @@index([propertyId, status])
  @@index([propertyId, readinessStatus])
  @@index([status, isPubliclyVisible])
  @@index([deletedAt])
  @@map("units")
}

model UnitImage {
  id        String   @id @default(uuid()) @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  imageUrl  String   @map("image_url")
  storageKey String? @map("storage_key")
  caption   String?
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  isCover   Boolean  @default(false) @map("is_cover")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId, sortOrder])
  @@index([unitId, isCover])
  @@map("unit_images")
}

model VacancyListing {
  id           String               @id @default(uuid()) @db.Uuid
  unitId       String               @map("unit_id") @db.Uuid
  unit         Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  landlordId   String               @map("landlord_id") @db.Uuid
  landlord     Landlord             @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  title        String
  description  String?
  status       VacancyStatus        @default(PRIVATE)
  publishedAt  DateTime?            @map("published_at")
  applications VacancyApplication[]
  inspections  InspectionBooking[]
  savedRentals SavedRental[]
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  @@index([unitId, status])
  @@index([status, publishedAt])
  @@index([landlordId])
  @@map("vacancy_listings")
}

model VacancyApplication {
  id                  String                       @id @default(uuid()) @db.Uuid
  applicantId         String                       @map("applicant_id") @db.Uuid
  applicant           Applicant                    @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  vacancyListingId    String?                      @map("vacancy_listing_id") @db.Uuid
  vacancyListing      VacancyListing?              @relation(fields: [vacancyListingId], references: [id], onDelete: Restrict)
  propertyId          String                       @map("property_id") @db.Uuid
  property            Property                     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unitId              String                       @map("unit_id") @db.Uuid
  unit                Unit                         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  landlordId          String                       @map("landlord_id") @db.Uuid
  landlord            Landlord                     @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  assignedCaretakerId String?                      @map("assigned_caretaker_id") @db.Uuid
  assignedCaretaker   Caretaker?                   @relation("ApplicationCaretaker", fields: [assignedCaretakerId], references: [id], onDelete: SetNull)
  createdById         String                       @map("created_by_id") @db.Uuid
  createdBy           User                         @relation("ApplicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  notes               String?
  status              ApplicationStatus            @default(PENDING)
  reviewedAt          DateTime?                    @map("reviewed_at")
  rejectionReason     String?                      @map("rejection_reason")
  approvalHistory     ApplicationApprovalHistory[]
  inspectionBookings  InspectionBooking[]
  tenancy             Tenancy?
  occupancyAssignment OccupancyAssignment?
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  deletedAt           DateTime?                    @map("deleted_at")

  @@index([unitId, status])
  @@index([status, createdAt])
  @@index([landlordId, status, createdAt])
  @@index([propertyId, status])
  @@index([assignedCaretakerId, createdAt])
  @@index([applicantId, createdAt])
  @@index([deletedAt])
  @@map("vacancy_applications")
}

model ApplicationApprovalHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  application   VacancyApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedById  String             @map("reviewed_by_id") @db.Uuid
  reviewedBy    User               @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  fromStatus    ApplicationStatus  @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  note          String?
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@index([reviewedById, createdAt])
  @@map("application_approval_history")
}

model InspectionBooking {
  id                   String              @id @default(uuid()) @db.Uuid
  applicantId          String              @map("applicant_id") @db.Uuid
  applicant            Applicant           @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  vacancyListingId     String              @map("vacancy_listing_id") @db.Uuid
  vacancyListing       VacancyListing      @relation(fields: [vacancyListingId], references: [id], onDelete: Restrict)
  unitId               String              @map("unit_id") @db.Uuid
  unit                 Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  vacancyApplicationId String?             @map("vacancy_application_id") @db.Uuid
  vacancyApplication   VacancyApplication? @relation(fields: [vacancyApplicationId], references: [id], onDelete: SetNull)
  scheduledAt          DateTime            @map("scheduled_at")
  status               InspectionStatus    @default(REQUESTED)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@index([applicantId, scheduledAt])
  @@index([unitId, status])
  @@map("inspection_bookings")
}

model Tenancy {
  id                        String                   @id @default(uuid()) @db.Uuid
  userId                    String                   @map("user_id") @db.Uuid
  user                      User                     @relation("TenantUser", fields: [userId], references: [id], onDelete: Restrict)
  unitId                    String                   @map("unit_id") @db.Uuid
  unit                      Unit                     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  propertyId                String                   @map("property_id") @db.Uuid
  property                  Property                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  landlordId                String                   @map("landlord_id") @db.Uuid
  landlord                  Landlord                 @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  applicantId               String                   @map("applicant_id") @db.Uuid
  applicant                 Applicant                @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  vacancyApplicationId      String?                  @unique @map("vacancy_application_id") @db.Uuid
  vacancyApplication        VacancyApplication?      @relation(fields: [vacancyApplicationId], references: [id], onDelete: SetNull)
  tenantOnboardingRequestId String?                  @unique @map("tenant_onboarding_request_id") @db.Uuid
  tenantOnboardingRequest   TenantOnboardingRequest? @relation(fields: [tenantOnboardingRequestId], references: [id], onDelete: SetNull)
  previousTenancyId         String?                  @unique @map("previous_tenancy_id") @db.Uuid
  previousTenancy           Tenancy?                 @relation("TenancyRenewal", fields: [previousTenancyId], references: [id], onDelete: SetNull)
  renewedTenancy            Tenancy?                 @relation("TenancyRenewal")
  startDate                 DateTime                 @map("start_date")
  endDate                   DateTime                 @map("end_date")
  rentAmount                Decimal                  @map("rent_amount") @db.Decimal(14, 2)
  paymentFrequency          PaymentFrequency         @default(YEARLY) @map("payment_frequency")
  status                    TenancyStatus            @default(PENDING)
  notes                     String?
  terminatedAt              DateTime?                @map("terminated_at")
  occupancyRecords          OccupancyRecord[]
  occupancyAssignments      OccupancyAssignment[]
  rentPayments              RentPayment[]
  renewalPayments           LeaseRenewalPayment[]
  paymentTransactions       PaymentTransaction[]
  maintenanceRequests       MaintenanceRequest[]
  agreement                 TenancyAgreement?
  invitations               TenantInvitation[]
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  deletedAt                 DateTime?                @map("deleted_at")

  @@index([unitId, status])
  @@index([userId, status])
  @@index([landlordId, status])
  @@index([landlordId, endDate, status])
  @@index([applicantId, status])
  @@map("tenancies")
}

model TenantOnboardingRequest {
  id                     String                 @id @default(uuid()) @db.Uuid
  propertyId             String                 @map("property_id") @db.Uuid
  property               Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unitId                 String                 @map("unit_id") @db.Uuid
  unit                   Unit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  landlordId             String                 @map("landlord_id") @db.Uuid
  landlord               Landlord               @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  submittedByUserId      String                 @map("submitted_by_user_id") @db.Uuid
  submittedByUser        User                   @relation("OnboardingSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedByCaretakerId String?                @map("submitted_by_caretaker_id") @db.Uuid
  submittedByCaretaker   Caretaker?             @relation(fields: [submittedByCaretakerId], references: [id], onDelete: SetNull)
  firstName              String                 @map("first_name")
  lastName               String                 @map("last_name")
  email                  String?
  phone                  String?
  startDate              DateTime               @map("start_date")
  endDate                DateTime               @map("end_date")
  rentAmount             Decimal                @map("rent_amount") @db.Decimal(14, 2)
  paymentFrequency       PaymentFrequency       @map("payment_frequency")
  notes                  String?
  status                 TenantOnboardingStatus @default(PENDING)
  reviewedAt             DateTime?              @map("reviewed_at")
  reviewedById           String?                @map("reviewed_by_id") @db.Uuid
  reviewedBy             User?                  @relation("OnboardingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason        String?                @map("rejection_reason")
  tenancy                Tenancy?
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  deletedAt              DateTime?              @map("deleted_at")

  @@index([landlordId, status, createdAt])
  @@index([propertyId, status])
  @@index([unitId, status])
