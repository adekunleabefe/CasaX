  providerReference String?                   @map("provider_reference")
  authorizationUrl  String?                   @map("authorization_url")
  paidAt            DateTime?                 @map("paid_at")
  metadata          Json?
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@index([landlordId, status, createdAt])
  @@index([subscriptionId, status])
  @@index([planId])
  @@map("subscription_payments")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}
